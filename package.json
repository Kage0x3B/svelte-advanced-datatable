{
    "name": "svelte-advanced-datatable",
    "version": "0.8.1",
    "scripts": {
        "dev": "vite dev",
        "build": "svelte-kit sync && svelte-package",
        "build-docs": "svelte-kit sync && typedoc && node prepareApiReferenceFiles.js && vite build",
        "preview": "vite preview",
        "test": "npm run test:integration && npm run test:unit",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "test:integration": "playwright test",
        "test:unit": "vitest"
    },
    "devDependencies": {
        "@faker-js/faker": "^9.4.0",
        "@iconify-json/fa6-brands": "^1.2.5",
        "@iconify-json/mdi": "^1.2.3",
        "@playwright/test": "^1.50.0",
        "@sveltejs/adapter-static": "^3.0.8",
        "@sveltejs/kit": "2.16.0",
        "@sveltejs/package": "^2.3.9",
        "@sveltejs/vite-plugin-svelte": "^5.0.3",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.16",
        "@tailwindcss/vite": "^4.0.1",
        "@tanstack/svelte-query": "https://pkg.pr.new/@tanstack/svelte-query@56f67c7",
        "@types/luxon": "^3.4.2",
        "@types/node": "^22.12.0",
        "@typescript-eslint/eslint-plugin": "^8.22.0",
        "@typescript-eslint/parser": "^8.22.0",
        "autoprefixer": "^10.4.20",
        "clsx": "^2.1.1",
        "daisyui": "5.0.0-beta.6",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-svelte": "^2.46.1",
        "github-slugger": "^2.0.0",
        "highlight.js": "^11.11.1",
        "luxon": "^3.5.0",
        "marked": "^15.0.6",
        "mdsvex": "^0.12.3",
        "prettier": "^3.4.2",
        "prettier-plugin-svelte": "^3.3.3",
        "runed": "^0.25.0",
        "sass": "^1.83.4",
        "svelte": "^5.19.6",
        "svelte-check": "^4.1.4",
        "svelte-highlight": "^7.8.2",
        "svelte-i18n": "^4.0.1",
        "svelte-preprocess": "^6.0.3",
        "svelte-toolbelt": "^0.7.1",
        "tailwindcss": "^4.0.1",
        "tslib": "^2.8.1",
        "typedoc": "^0.27.6",
        "typedoc-plugin-markdown": "^4.4.1",
        "typedoc-plugin-mdn-links": "^4.0.10",
        "typescript": "^5.7.3",
        "unist-builder": "^4.0.0",
        "unplugin-icons": "^22.0.0",
        "vite": "6.0.0",
        "vitest": "^3.0.4"
    },
    "type": "module",
    "peerDependencies": {
        "@tanstack/query-core": "5.x",
        "svelte": "5.x",
        "svelte-i18n": "4.x"
    },
    "peerDependenciesMeta": {
        "svelte": {
            "optional": false
        },
        "svelte-i18n": {
            "optional": true
        },
        "@tanstack/query-core": {
            "optional": true
        },
        "@tanstack/svelte-query": {
            "optional": true
        }
    },
    "homepage": "https://svelte-advanced-datatable.pages.dev",
    "bugs": {
        "url": "https://github.com/Kage0x3B/svelte-advanced-datatable/issues",
        "email": "moritz.hein@live.de"
    },
    "author": {
        "name": "Moritz Hein",
        "email": "moritz.hein@live.de",
        "url": "https://moritz.website"
    },
    "license": "MIT",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./daisyUi": {
            "types": "./dist/daisyUi/index.d.ts",
            "default": "./dist/daisyUi/index.js"
        },
        "./dataSource/svelteQuery": {
            "types": "./dist/dataSource/svelteQuery/index.d.ts",
            "default": "./dist/dataSource/svelteQuery/index.js"
        },
        "./dataSource": {
            "types": "./dist/dataSource/index.d.ts",
            "default": "./dist/dataSource/index.js"
        },
        "./internal": {
            "types": "./dist/internal/index.d.ts",
            "svelte": "./dist/internal/index.js",
            "default": "./dist/internal/index.js"
        },
        "./searchParser": {
            "types": "./dist/searchParser/index.d.ts",
            "svelte": "./dist/searchParser/index.js",
            "default": "./dist/searchParser/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "svelte": "./dist/index.js",
    "typesVersions": {
        ">4.0": {
            "index.d.ts": [
                "./dist/index.d.ts"
            ],
            "daisyUi": [
                "./dist/daisyUi/index.d.ts"
            ],
            "dataSource": [
                "./dist/dataSource/index.d.ts"
            ],
            "dataSource/svelteQuery": [
                "./dist/dataSource/svelteQuery/index.d.ts"
            ],
            "internal": [
                "./dist/internal/index.d.ts"
            ],
            "searchParser": [
                "./dist/searchParser/index.d.ts"
            ]
        }
    },
    "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
