{
    "name": "svelte-advanced-datatable",
    "version": "0.8.10",
    "scripts": {
        "dev": "vite dev",
        "build": "svelte-kit sync && svelte-package",
        "build-docs": "svelte-kit sync && typedoc && node prepareApiReferenceFiles.js && vite build",
        "preview": "vite preview",
        "test": "npm run test:integration && npm run test:unit",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "test:integration": "playwright test",
        "test:unit": "vitest"
    },
    "devDependencies": {
        "@faker-js/faker": "^9.9.0",
        "@iconify-json/fa6-brands": "^1.2.6",
        "@iconify-json/mdi": "^1.2.3",
        "@playwright/test": "^1.57.0",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "2.49.2",
        "@sveltejs/package": "^2.5.7",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/svelte-query": "https://pkg.pr.new/@tanstack/svelte-query@56f67c7",
        "@types/luxon": "^3.7.1",
        "@types/node": "^22.19.2",
        "@typescript-eslint/eslint-plugin": "^8.49.0",
        "@typescript-eslint/parser": "^8.49.0",
        "autoprefixer": "^10.4.22",
        "clsx": "^2.1.1",
        "daisyui": "5.5.13",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.13.1",
        "github-slugger": "^2.0.0",
        "highlight.js": "^11.11.1",
        "luxon": "^3.7.2",
        "marked": "^15.0.12",
        "mdsvex": "^0.12.6",
        "prettier": "^3.7.4",
        "prettier-plugin-svelte": "^3.4.0",
        "runed": "^0.37.0",
        "sass": "^1.96.0",
        "svelte": "^5.46.0",
        "svelte-check": "^4.3.4",
        "svelte-highlight": "^7.9.0",
        "svelte-i18n": "^4.0.1",
        "svelte-preprocess": "^6.0.3",
        "svelte-toolbelt": "^0.10.6",
        "tailwindcss": "^4.1.18",
        "tslib": "^2.8.1",
        "typedoc": "^0.27.9",
        "typedoc-plugin-markdown": "^4.9.0",
        "typedoc-plugin-mdn-links": "^4.0.15",
        "typescript": "^5.9.3",
        "unist-builder": "^4.0.0",
        "unplugin-icons": "^22.5.0",
        "vite": "7.2.7",
        "vitest": "^4.0.15"
    },
    "type": "module",
    "peerDependencies": {
        "@tanstack/query-core": "5.x",
        "svelte": "5.x",
        "svelte-i18n": "4.x"
    },
    "peerDependenciesMeta": {
        "svelte": {
            "optional": false
        },
        "svelte-i18n": {
            "optional": true
        },
        "@tanstack/query-core": {
            "optional": true
        },
        "@tanstack/svelte-query": {
            "optional": true
        }
    },
    "homepage": "https://svelte-advanced-datatable.pages.dev",
    "bugs": {
        "url": "https://github.com/Kage0x3B/svelte-advanced-datatable/issues",
        "email": "moritz.hein@live.de"
    },
    "author": {
        "name": "Moritz Hein",
        "email": "moritz.hein@live.de",
        "url": "https://moritz.website"
    },
    "license": "MIT",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./daisyUi": {
            "types": "./dist/daisyUi/index.d.ts",
            "default": "./dist/daisyUi/index.js"
        },
        "./dataSource/svelteQuery": {
            "types": "./dist/dataSource/svelteQuery/index.d.ts",
            "default": "./dist/dataSource/svelteQuery/index.js"
        },
        "./dataSource": {
            "types": "./dist/dataSource/index.d.ts",
            "default": "./dist/dataSource/index.js"
        },
        "./internal": {
            "types": "./dist/internal/index.d.ts",
            "svelte": "./dist/internal/index.js",
            "default": "./dist/internal/index.js"
        },
        "./searchParser": {
            "types": "./dist/searchParser/index.d.ts",
            "svelte": "./dist/searchParser/index.js",
            "default": "./dist/searchParser/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "svelte": "./dist/index.js",
    "typesVersions": {
        ">4.0": {
            "index.d.ts": [
                "./dist/index.d.ts"
            ],
            "daisyUi": [
                "./dist/daisyUi/index.d.ts"
            ],
            "dataSource": [
                "./dist/dataSource/index.d.ts"
            ],
            "dataSource/svelteQuery": [
                "./dist/dataSource/svelteQuery/index.d.ts"
            ],
            "internal": [
                "./dist/internal/index.d.ts"
            ],
            "searchParser": [
                "./dist/searchParser/index.d.ts"
            ]
        }
    },
    "packageManager": "pnpm@10.11.1+sha512.e519b9f7639869dc8d5c3c5dfef73b3f091094b0a006d7317353c72b124e80e1afd429732e28705ad6bfa1ee879c1fce46c128ccebd3192101f43dd67c667912"
}
