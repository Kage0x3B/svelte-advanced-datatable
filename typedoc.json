{
    "$schema": "https://typedoc.org/schema.json",
    "plugin": ["typedoc-plugin-markdown"],
    "entryPoints": [
        "./src/lib/index.ts",
        "./src/lib/daisyUi/index.ts",
        "./src/lib/internal/index.ts",
        "./src/lib/searchParser/index.ts"
    ],
    "exclude": ["./src/routes/(docs)/(api-reference)/api-reference"],
    "outputs": [
        {
            "name": "markdown",
            "path": "./src/routes/(docs)/(api-reference)/api-reference"
        },
        {
            "name": "json",
            "path": "./src/routes/(docs)/(api-reference)/api-reference/api-reference-meta.json"
        }
    ],
    "name": "Svelte Advanced DataTable",
    "skipErrorChecking": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeInternal": true,
    "hideGenerator": true,
    "readme": "none",
    "githubPages": false,
    "basePath": "./src/lib"
}
